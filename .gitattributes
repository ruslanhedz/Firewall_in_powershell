# Set the default behavior to automatically detect text files and normalize line endings
* text=auto

# Linux / Bash scripts must strictly always use LF line endings
*.sh text eol=lf

# PowerShell scripts (normalized to LF across Windows and Linux)
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# Configuration and documentation
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.conf text eol=lf
*.sha256 text eol=lf

# Windows Firewall export policy files (binary)
*.wfw binary

